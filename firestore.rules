rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - displayName: string (required, 1..50 chars) - Player's display name
    //   - email: string (optional, <= 100 chars) - Account email
    //   - photoURL: string (optional, <= 500 chars) - Profile picture URL
    //   - isGuest: bool (required) - True if anonymous guest player
    //   - provider: string (required, 'google' | 'guest') - Auth provider
    //   - createdAt: string or timestamp (required) - Registration time
    //   - lastLoginAt: string or timestamp (required) - Last active time
    //   - progress: map (required) - Game campaign save data
    //     - coins: int/number (>= 0) - Earned coins
    //     - stars: int/number (>= 0) - Total stars collected
    //     - unlocked: int/number (>= 1) - Highest unlocked level
    //     - owned: list of string - Owned vehicle IDs
    //     - vehicle: string - Currently selected vehicle
    //     - bests: map - Best times per level
    //     - starsBy: map - Stars earned per level
    //     - upg: map - Vehicle upgrades
    //     - cos: map - Cosmetics unlocked/equipped
    //     - trophy: bool - Ending trophy unlocked
    //
    // Collection: duel_matches
    // Document ID: {matchId}
    // Fields:
    //   - roomCode: string - Duel room code
    //   - mode: string ('race' | 'shoot')
    //   - winner: string (UID or player name)
    //   - players: list of strings
    //   - timestamp: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserDoc(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
        && data.isGuest is bool
        && (data.provider == 'google' || data.provider == 'guest')
        && ('progress' in data && data.progress is map);
    }

    // Users Collection - strict per-user ownership and privacy
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserDoc(request.resource.data);
      allow update: if isOwner(userId) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Duel Matches Collection - players in match can record results
    match /duel_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.mode in ['race', 'shoot'];
      allow update, delete: if false; // Immutable match history
    }

    // Public Leaderboards Collection
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false; // Only updated via Backend Firebase Admin SDK
    }
  }
}
